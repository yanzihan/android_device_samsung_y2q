<!--
     These resources exist purely to let Settings be customised per device.

     This file was moved here from the old
     overlay/packages/apps/Settings/res/values/config.xml when y2q's overlays were
     converted from DEVICE_PACKAGE_OVERLAYS to static RROs; the values themselves
     are unchanged.  The last entry came from the separate
     overlay-lineage/packages/apps/Settings/res/values/config.xml, merged in so
     that this directory holds a single config.xml - an RRO only reads resources
     from files named exactly config.xml, so a second file would be ignored.
     See ./AndroidManifest.xml for the target package (com.android.settings).
-->
<resources>
    <!-- The radius of the enrolment progress bar, in dp.

         Used by the under-display fingerprint enrolment UI
         (Settings/app/src/com/android/settings/biometrics/fingerprint/
         FingerprintEnrollEnrolling.java).  Shape and size are matched to y2q's
         QBT2000 ultrasonic sensor, which sits under the display around
         y = 78% of the screen height. -->
    <integer name="config_udfpsEnrollProgressBar" translatable="false">70</integer>

    <!-- Whether to show the minimum refresh rate list in display settings.

         Defined by LineageOS in packages/apps/Settings/res/values/lineage_config.xml
         with a default of false, and read by
         MinRefreshRatePreferenceController (Settings/.../display/
         MinRefreshRatePreferenceController.java:50).  With the default, the
         "smooth display" (peak refresh rate) toggle is the only refresh-rate
         control; enabling this replaces it with the "minimum refresh rate" picker.

         Note an RRO matches on the TARGET PACKAGE, not on which file inside the
         target the resource came from - config.xml and lineage_config.xml both
         belong to com.android.settings, so overlaying them from one RRO file
         works.  The panel exposes 120/96/60/48 Hz in the 1080x2400 and 720x1600
         mode groups, so the picker has a real effect there. -->
    <bool name="config_show_min_refresh_rate_switch">true</bool>

    <!-- Max network scan search time in seconds.

         Read by NetworkScanRepository (Settings/.../network/telephony/scan/
         NetworkScanRepository.kt:122) to bound a manual "choose network" scan.
         The AOSP default is 300; r8q shipped 254 and that value is inherited here
         unchanged.  Nothing measured suggests 254 is wrong for y2q, but if manual
         network selection ever lists too few operators, raising this towards (or
         past) 300 is the first thing to try. -->
    <integer name="config_network_scan_helper_max_search_time_sec">254</integer>
</resources>
