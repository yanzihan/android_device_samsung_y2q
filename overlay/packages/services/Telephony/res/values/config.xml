<!-- Overlay for packages/services/Telephony on y2q (Galaxy S20+ 5G, SM-G9860,
     Qualcomm SM8250).

     AOSP defaults config_ims_mmtel_package to an EMPTY string, and no IMS/MmTel
     provider ships in the LineageOS tree for this device: Samsung's own IMS
     stack is closed source, and the Qualcomm IMS blobs that exist in the stock
     firmware (com.qualcomm.qti.imscmservice@2.x, vendor.qti.imsrtpservice@3.0,
     ...) are not packaged here at all.  With the resource empty, ImsResolver
     binds nothing and calls fall back to circuit-switched - which is fatal on
     carriers that have already shut 2G/3G down.

     PhhIms (packages/apps/PhhIms, package me.phh.ims) implements
     android.telephony.ims.ImsService and registers itself as the MmTel
     provider, so pointing this resource at it is what makes VoLTE/VoWiFi
     possible on a ROM with no vendor IMS stack. -->
<resources>
    <string name="config_ims_mmtel_package" translatable="false">me.phh.ims</string>
</resources>
