// Build-time configuration for hardware/broadcom/libbt, named from device.mk via
// soong_config_set(brcm_libbt, custom_bt_config, ...).  Without it the library
// falls back to include/vnd_generic.txt, whose UART port is /dev/ttyO1.
filegroup {
    name: "vnd_y2q.txt",
    srcs: ["libbt_vndcfg.txt"],
}

// The vendor library the Bluetooth HAL loads, taken from the stock SM-G9860 image
// rather than built from hardware/broadcom/libbt: the source build's LPM/wake
// support is compiled out by default, so the BCM4375 can be put to sleep and never
// woken and Bluetooth cannot start.  See the bluetooth commits for the full trace.
//
// prefer: true is what makes this win over the identically named source module in
// hardware/broadcom/libbt.  Its extra /proc access needs the genfscon labels in
// sepolicy/vendor/genfs_contexts.
cc_prebuilt_library_shared {
    name: "libbt-vendor",
    owner: "samsung",
    prefer: true,
    proprietary: true,
    vendor: true,
    compile_multilib: "64",
    srcs: ["libbt-vendor.so"],
    shared_libs: [
        "libc++",
        "libc",
        "libcutils",
        "libdl",
        "liblog",
        "libm",
        "libtinyxml2",
    ],
    strip: {
        none: true,
    },
}

// Runtime configuration read by conf.c through VENDOR_LIB_CONF_FILE.  Must land in
// /vendor/etc/bluetooth/ to carry a label the Bluetooth HAL domain may read.
prebuilt_etc {
    name: "bt_vendor.conf",
    src: "bt_vendor.conf",
    sub_dir: "bluetooth",
    vendor: true,
}

// Loaded by RemoteDevices from a static initialiser; absent, the whole Bluetooth
// process aborts.  It only has to exist.
prebuilt_etc {
    name: "bt_rc_name.conf",
    src: "bt_rc_name.conf",
    sub_dir: "bluetooth",
    vendor: true,
}
