# Samsung's prebuilt NFC and secure-element HALs use their own binary names, which
# sm8250-common's file_contexts does not cover.  Unlabelled they stay vendor_file
# and init refuses to start the service at all ("has incorrect label").
/(vendor|system/vendor)/bin/hw/nxp\.android\.hardware\.nfc@1\.2-service          u:object_r:hal_nfc_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.secure_element@1\.1-service    u:object_r:hal_secure_element_default_exec:s0
