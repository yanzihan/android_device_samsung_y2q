# Bluetooth power and sleep/wake nodes.
#
# AOSP labels the PCI/USB rfkill layout (system/sepolicy/private/genfs_contexts
# labels /class/rfkill/rfkillN/state) and grants hal_bluetooth rw access to it.
# This kernel puts Bluetooth behind Samsung's soc:bt_driver platform device
# instead, so that rule does not match and the nodes come out as the generic
# u:object_r:sysfs:s0 / u:object_r:proc:s0.  Without the labels below the HAL gets
# EACCES and Bluetooth fails to come up.
#
# Only the vendored rfkill path is listed: the /class/rfkill/... form is already
# in the AOSP file, and repeating it fails the build with "duplicate entry for
# genfs entry".
#
# No allow rule is needed here either - sm8250-common's hal_bluetooth_default.te
# does hal_server_domain(hal_bluetooth_default, hal_bluetooth), so the
# hal_bluetooth permission set is inherited.
genfscon sysfs /devices/platform/soc/soc:bt_driver/rfkill/rfkill0/state    u:object_r:sysfs_bluetooth_writable:s0

# libbt-vendor drives the controller's low power state and the BT_WAKE line
# through these two nodes.  AOSP declares proc_bluetooth_writable and grants it to
# hal_bluetooth (system/sepolicy/private/hal_bluetooth.te); only the labelling was
# missing.
genfscon proc /bluetooth/sleep/lpm         u:object_r:proc_bluetooth_writable:s0
genfscon proc /bluetooth/sleep/btwrite     u:object_r:proc_bluetooth_writable:s0
