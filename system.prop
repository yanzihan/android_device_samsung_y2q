#
# System properties for y2q (Galaxy S20+ 5G, SM-G9860, SM8250)
#

# Force the telephony framework to advertise VoLTE / VT / VoWiFi regardless of the
# carrier, so the UI toggles and ImsResolver come up while PhhIms is brought
# online.  Not a substitute for correct CarrierConfig.
#
# These must be integers: property_contexts labels them "exact int", so "true" is
# rejected by init and the override silently does nothing.
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=0
persist.dbg.wfc_avail_ovr=1

# HCI command timeouts.  The 2000 ms default is too tight for the BCM4375: the chip
# sleeps after ~1500 ms idle and needs ~500 ms to answer once BT_WAKE is asserted,
# so the first command after an idle period lands just past the deadline, and the
# stack then calls log::fatal() and takes the connection down with it.
#
# All three must move together - bluetooth.gd.start_timeout bounds the same
# controller handshake during start-up, and leaving it at its 3000 ms default while
# the HCI timeout is 8000 ms makes Bluetooth fail to start at all.
#
# Read once at start-up, so they only take effect on a Bluetooth restart.
bluetooth.hci.timeout_milliseconds=8000
bluetooth.hci.restart_timeout_milliseconds=15000
bluetooth.gd.start_timeout=20000
