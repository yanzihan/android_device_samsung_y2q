# Properties for y2q (Galaxy S20+ 5G, SM-G9860).
#
# IMPORTANT: never add a property here that sm8250-common/vendor.prop also
# defines.  The vendor build.prop is generated by concatenating every file in
# TARGET_VENDOR_PROP, and post_process_props fails the build with
# "error: found duplicate sysprop assignments" when the same non-optional
# sysprop is assigned twice with different values.  (Identical duplicates are
# tolerated but pointless.)  Properties that genuinely need a different value per
# device are therefore NOT set in sm8250-common at all - each device sets its own.

# ---------------------------------------------------------------------------
# NFC (NXP SN100U)
#
# r8q and y2q are both on the NXP SN100U, but the S20+/S21U (SM-G9860/SM-G9980)
# configuration differs from the S22 (SM-S901E) one.  Values below are taken from
# the SM-G9860 stock firmware's own vendor/build.prop:
#
#   property                                G9860/G9980   S901E
#   ro.vendor.nfc.support.advancedsetting   true          false
#   ro.vendor.nfc.support.defaultaid        false         true
#   ro.vendor.nfc.support.nonaid            false         true
#
# The two values NOT listed here (autoselect/ese/othercategory/uicc/antpos) are
# identical on both and stay in sm8250-common.  r8q's own firmware dump is not
# available, so r8q keeps the previous S901E-style values - revisit if its NFC
# turns out to need these too.
# ---------------------------------------------------------------------------
ro.vendor.nfc.feature.chipname=NXP_SN100U
ro.vendor.nfc.support.advancedsetting=true
ro.vendor.nfc.support.defaultaid=false
ro.vendor.nfc.support.nonaid=false

# ---------------------------------------------------------------------------
# Display / refresh rate
#
# sm8250-common used to carry enable_frame_rate_override=false (inherited from
# r8q).  With frame rate override disabled the framework never switches the panel
# refresh rate, so the 120 Hz modes the kernel exposes are never selected: the
# device sits at 60 Hz and Settings shows only the "smooth display" toggle
# instead of a refresh-rate picker.  A working SM8350/p3q build of the same
# LineageOS reports true, and y2q's panel driver exposes the same 12 timings
# (1440x3200 / 1080x2400 / 720x1600 @ 120/96/60/48), so only this property was
# blocking it.
# ---------------------------------------------------------------------------
ro.surface_flinger.enable_frame_rate_override=true
ro.surface_flinger.game_default_frame_rate_override=60
