# Properties for y2q (Galaxy S20+ 5G, SM-G9860).
#
# Never add a property here that sm8250-common/vendor.prop also defines: the vendor
# build.prop concatenates every file in TARGET_VENDOR_PROP, and post_process_props
# fails the build with "found duplicate sysprop assignments".  Properties that need
# a per-device value are therefore not set in sm8250-common at all.

# y2q's sensor is a Qualcomm QBT2000, the ultrasonic under-display sensor used
# across the S20 family, so udfps (UNDER_DISPLAY_ULTRASONIC) rather than
# udfps_optical.  Unset, the HAL reports REAR and the framework never takes the
# under-display path.
ro.vendor.fingerprint.type=udfps

# Sensor position as "X|Y|R", parsed by hardware/samsung/aidl/fingerprint/
# Fingerprint.cpp into SensorLocation.  Without it the HAL reports an empty
# location list and the UI cannot draw the fingerprint icon or lay out enrolment.
#
# Expressed in the panel's maximum resolution (1440x3200), not the default mode
# (1080x2400); SystemUI scales it down by physicalPixelDisplaySizeRatio = 0.75.
# Same panel and sensor placement as y2s, which uses this value.
ro.vendor.fingerprint.sensor_location=720|2500|150

# NXP SN100U.  The S20+/S21U (SM-G9860/SM-G9980) stock firmware differs from the
# S22 (SM-S901E) in these three; the remaining ro.vendor.nfc.support.* values are
# identical and stay in sm8250-common.
ro.vendor.nfc.feature.chipname=NXP_SN100U
ro.vendor.nfc.support.advancedsetting=true
ro.vendor.nfc.support.defaultaid=false
ro.vendor.nfc.support.nonaid=false

# The panel driver exposes 12 timings (1440x3200 / 1080x2400 / 720x1600 at
# 120/96/60/48 Hz).  With frame rate override off the framework never switches, so
# the device sits at 60 Hz and Settings offers no refresh-rate picker.
ro.surface_flinger.enable_frame_rate_override=true
ro.surface_flinger.game_default_frame_rate_override=60
